# 사주담 환경변수 설정
# cp .env.example .env 후 아래 값들을 실제 값으로 교체하세요

# Database (docker compose 기준: service 이름 'db' 사용)
DB_HOST=db
DB_PORT=5432
DB_NAME=saju_db
DB_USER=saju
DB_PASSWORD=your_db_password_here

# JWT 인증 (최소 32자 랜덤 문자열)
SECRET_KEY=your_secret_key_here_at_least_32_chars
REFRESH_SECRET_KEY=your_refresh_secret_key_here_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis
REDIS_URL=redis://redis:6379/1

# AI 해석 (필수 — Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-5

# 환경
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:8002

# 외부 포트 (기본 8002)
# HOST_PORT=8002
